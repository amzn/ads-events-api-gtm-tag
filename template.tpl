- name: GA4 auto-detect builds match keys from user_data fields
  code: |-
    function buildMatchKeysAuto(userData, manualTable) {
      var matchKeys = [];
      var addedTypes = {};
      // Manual entries first
      for (var i = 0; i < manualTable.length; i++) {
        if (manualTable[i].value) {
          matchKeys.push({ type: manualTable[i].type, values: [manualTable[i].value] });
          addedTypes[manualTable[i].type] = true;
        }
      }
      // Auto-detect fills gaps
      var mapping = [
        { type: 'EMAIL', key: 'email' },
        { type: 'PHONE', key: 'phone' },
        { type: 'FIRST_NAME', key: 'first_name' },
        { type: 'LAST_NAME', key: 'last_name' }
      ];
      for (var j = 0; j < mapping.length; j++) {
        if (!addedTypes[mapping[j].type] && userData[mapping[j].key]) {
          matchKeys.push({ type: mapping[j].type, values: [userData[mapping[j].key]] });
        }
      }
      return matchKeys;
    }
    // Auto-detect populates from user_data
    var result = buildMatchKeysAuto(
      { email: 'test@example.com', phone: '1234567890', first_name: 'John', last_name: 'Doe' },
      []
    );
    assertThat(result.length).isEqualTo(4);
    assertThat(result[0]).isEqualTo({ type: 'EMAIL', values: ['test@example.com'] });
    assertThat(result[1]).isEqualTo({ type: 'PHONE', values: ['1234567890'] });
    assertThat(result[2]).isEqualTo({ type: 'FIRST_NAME', values: ['John'] });
    assertThat(result[3]).isEqualTo({ type: 'LAST_NAME', values: ['Doe'] });
    // Manual override prevents auto-detect for that type
    var result2 = buildMatchKeysAuto(
      { email: 'auto@example.com', phone: '1111111111' },
      [{ type: 'EMAIL', value: 'manual@override.com' }]
    );
    assertThat(result2.length).isEqualTo(2);
    assertThat(result2[0]).isEqualTo({ type: 'EMAIL', values: ['manual@override.com'] });
    assertThat(result2[1]).isEqualTo({ type: 'PHONE', values: ['1111111111'] });
    // Empty user_data with no manual entries returns empty
    var result3 = buildMatchKeysAuto({}, []);
    assertThat(result3.length).isEqualTo(0);


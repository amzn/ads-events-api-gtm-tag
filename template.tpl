- name: isAlreadyHashed returns true for valid 64-char hex string
  code: |-
    const isAlreadyHashed = (value) => {
      if (!value) return false;
      var str = (value || '').toString().trim();
      if (str.length !== 64) return false;
      for (var i = 0; i < str.length; i++) {
        var char = str.charAt(i);
        if (!((char >= '0' && char <= '9') || (char >= 'a' && char <= 'f') || (char >= 'A' && char <= 'F'))) return false;
      }
      return true;
    };
    const validHash = 'b94d27b9934d3e08a52e52d7da7dabfac484efe04294e576f4b7b5b5b5b5b5b5';
    assertThat(isAlreadyHashed(validHash)).isTrue();
    assertThat(isAlreadyHashed('notahash')).isFalse();
    assertThat(isAlreadyHashed('b94d27b9934d3e08a52e52d7da7dabfac484efe04294e576f4b7b5b5b5b5b5b5EXTRA')).isFalse();
    assertThat(isAlreadyHashed('')).isFalse();
    assertThat(isAlreadyHashed(null)).isFalse();


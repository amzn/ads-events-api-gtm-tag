- name: Pre-hashed match key values are passed through without re-hashing
  code: |-
    function isAlreadyHashed(value) {
      if (!value) return false;
      var str = (value || '').toString().trim();
      if (str.length !== 64) return false;
      for (var i = 0; i < str.length; i++) {
        var c = str.charAt(i);
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))) return false;
      }
      return true;
    }
    function processMatchKey(value, field) {
      if (!value) return '';
      var originalValue = (value || '').toString().trim();
      if (field === 'maid' || field === 'rampId' || field === 'matchId' || field === 'realId' || field === 'merkleId' || field === 'kantarId' || field === 'fip') return originalValue;
      if (isAlreadyHashed(originalValue)) return originalValue.toLowerCase();
      return 'normalized_and_hashed_' + originalValue;
    }
    // Pre-hashed 64-char hex is passed through (lowercased)
    var hash = 'A94D27B9934D3E08A52E52D7DA7DABFAC484EFE37A8B64C15B5B5B5B5B5B5B5B';
    assertThat(processMatchKey(hash, 'email')).isEqualTo(hash.toLowerCase());
    assertThat(processMatchKey(hash, 'phone')).isEqualTo(hash.toLowerCase());
    assertThat(processMatchKey(hash, 'firstName')).isEqualTo(hash.toLowerCase());
    assertThat(processMatchKey(hash, 'address')).isEqualTo(hash.toLowerCase());
    // Raw PII goes through normalization + hashing
    assertThat(processMatchKey('user@example.com', 'email')).isEqualTo('normalized_and_hashed_user@example.com');
    // Identity fields bypass hashing entirely
    assertThat(processMatchKey(hash, 'maid')).isEqualTo(hash);
    // Empty/null returns empty string
    assertThat(processMatchKey('', 'email')).isEqualTo('');
    assertThat(processMatchKey(null, 'email')).isEqualTo('');

